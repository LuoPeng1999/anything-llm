###########################################
######## 密码复杂度 #######################
###########################################
# 强制执行组织用户的密码模式。
# 关于如何使用的文档 https://github.com/kamronbatman/joi-password-complexity
#PASSWORDMINCHAR=8
#PASSWORDMAXCHAR=250
#PASSWORDLOWERCASE=1
#PASSWORDUPPERCASE=1
#PASSWORDNUMERIC=1
#PASSWORDSYMBOL=1
#PASSWORDREQUIREMENTS=4

###########################################
######## 启用 HTTPS 服务器 ################
###########################################
# 启用此项并提供密钥和证书的路径/文件名，
# 服务器将使用 HTTPS 而不是 HTTP。
#ENABLE_HTTPS="true"
#HTTPS_CERT_PATH="sslcert/cert.pem"
#HTTPS_KEY_PATH="sslcert/key.pem"

