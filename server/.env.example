SERVER_PORT=3001
JWT_SECRET="my-random-string-for-seeding" # 请生成至少 12 个字符长的随机字符串。
# JWT_EXPIRY="30d" # (可选) https://docs.anythingllm.com/configuration#custom-ttl-for-sessions
SIG_KEY='passphrase' # 请生成至少 32 个字符长的随机字符串。
SIG_SALT='salt' # 请生成至少 32 个字符长的随机字符串。

