###########################################
######## 其他配置 ########################
###########################################

# 禁用从 UI 和前端 API 查看聊天记录。
# 更多信息请参阅 https://docs.anythingllm.com/configuration#disable-view-chat-history。
# DISABLE_VIEW_CHAT_HISTORY=1

# 启用简单的 SSO 传递，以便从第三方服务预验证用户。
# 更多信息请参阅 https://docs.anythingllm.com/configuration#simple-sso-passthrough。
# SIMPLE_SSO_ENABLED=1
# SIMPLE_SSO_NO_LOGIN=1
# SIMPLE_SSO_NO_LOGIN_REDIRECT=https://your-custom-login-url.com (可选)

# 允许收集器抓取任何 IP 地址 - 必须是字符串 "true" 才能启用
# 更多信息请参阅 https://docs.anythingllm.com/configuration#local-ip-address-scraping。
# COLLECTOR_ALLOW_ANY_IP="true"

# 指定使用 OCR 解析图像和 PDF 时的目标语言。
# 这是一个以逗号分隔的语言代码字符串列表。不支持的语言将被忽略。
# 默认为英语。查看 https://tesseract-ocr.github.io/tessdoc/Data-Files-in-different-versions.html 获取有效语言代码列表。
# TARGET_OCR_LANG=eng,deu,ita,spa,fra,por,rus,nld,tur,hun,pol,ita,spa,fra,por,rus,nld,tur,hun,pol

# 内置 puppeteer Chromium 实例的运行时标志
# 仅在通过 Docker 运行 AnythingLLM 的 Linux 机器上需要
# 且不想使用 --cap-add=SYS_ADMIN docker 参数时使用
# ANYTHINGLLM_CHROMIUM_ARGS="--no-sandbox,--disable-setuid-sandbox"

# 这将在开发环境中启用 HTTP 请求/响应日志记录。设置为真值字符串以启用，留空或注释掉以禁用。
# ENABLE_HTTP_LOGGER=""
# 这将为 HTTP 日志记录器启用时间戳。设置为真值字符串以启用，留空或注释掉以禁用。
# ENABLE_HTTP_LOGGER_TIMESTAMPS=""

# 禁用 Swagger API 文档端点。
# 设置为 "true" 以禁用 /api/docs 端点（建议用于生产部署）。
# DISABLE_SWAGGER_DOCS="true"

# 禁用代理调用的 MCP 冷却计时器
# 这可能会导致同一函数的无限递归调用
# 对于某些模型/提供商组合
# MCP_NO_COOLDOWN="true"
