###########################################
######## 向量数据库选择 ###################
###########################################
# 如果你使用的是向量数据库：Chroma，请启用以下所有项。
# VECTOR_DB="chroma"
# CHROMA_ENDPOINT='http://localhost:8000'
# CHROMA_API_HEADER="X-Api-Key"
# CHROMA_API_KEY="sk-123abc"

# 如果你使用的是向量数据库：Chroma Cloud，请启用以下所有项。
# VECTOR_DB="chromacloud"
# CHROMACLOUD_API_KEY="ck-your-api-key"
# CHROMACLOUD_TENANT=
# CHROMACLOUD_DATABASE=

# 如果你使用的是向量数据库：Pinecone，请启用以下所有项。
# VECTOR_DB="pinecone"
# PINECONE_API_KEY=
# PINECONE_INDEX=

# 如果你使用的是向量数据库：Astra DB，请启用以下所有项。
# VECTOR_DB="astra"
# ASTRA_DB_APPLICATION_TOKEN=
# ASTRA_DB_ENDPOINT=

# 如果你使用的是向量数据库：LanceDB，请启用以下所有项。
# VECTOR_DB="lancedb"

# 如果你使用的是向量数据库：PG Vector，请启用以下所有项。
VECTOR_DB="pgvector"
PGVECTOR_CONNECTION_STRING="postgresql://root:123456@localhost:5432/knowledge_base"
# PGVECTOR_TABLE_NAME="anythingllm_vectors" # 可选，但可以定义

# 如果你使用的是向量数据库：Weaviate，请启用以下所有项。
# VECTOR_DB="weaviate"
# WEAVIATE_ENDPOINT="http://localhost:8080"
# WEAVIATE_API_KEY=

# 如果你使用的是向量数据库：Qdrant，请启用以下所有项。
# VECTOR_DB="qdrant"
# QDRANT_ENDPOINT="http://localhost:6333"
# QDRANT_API_KEY=

# 如果你使用的是向量数据库：Milvus，请启用以下所有项。
# VECTOR_DB="milvus"
# MILVUS_ADDRESS="http://localhost:19530"
# MILVUS_USERNAME=
# MILVUS_PASSWORD=

# 如果你使用的是向量数据库：Zilliz Cloud，请启用以下所有项。
# VECTOR_DB="zilliz"
# ZILLIZ_ENDPOINT="https://sample.api.gcp-us-west1.zillizcloud.com"
# ZILLIZ_API_TOKEN=api-token-here

